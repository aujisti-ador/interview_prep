# Copy to .env and tweak if a port clashes on your machine.
WEB_PORT=8080
API_PORT=4000
DB_PORT=55432

POSTGRES_USER=jobcracker
POSTGRES_PASSWORD=jobcracker
POSTGRES_DB=jobcracker

# Set to true for one boot to force re-import of seed content
# (progress/attempts/notes are never touched by the seeder).
RESEED=false
